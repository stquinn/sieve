// Syncthing ignore — platform-specific and derived artifacts that must be
// rebuilt per-machine, never synced. Syncthing does NOT sync this file; it is
// tracked in git so every machine gets it via git pull.
// (?d) marks entries Syncthing may delete if they block a directory removal.

// Node: contains platform-native binaries (esbuild etc.) — syncing a
// linux-x64 node_modules to macOS breaks the build with "Exec format error".
// Rebuild locally: cd frontend && npm install
(?d)frontend/node_modules

// Go / Wails build outputs (regenerated by wails dev / wails build)
(?d)build/bin
(?d)/main
(?d)sieve_app
(?d)tmp-bin
(?d)bin
(?d)frontend/wailsjs

// Git worktrees and test/coverage artifacts
(?d).worktrees
(?d)*.test
(?d)*.out

// OS noise
(?d)**/.DS_Store
